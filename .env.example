
NODE_ENV=development

API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:5174

DATABASE_URL=postgresql://replace_with_database_username:replace_with_database_password@localhost:5434/platform_dev?schema=public
# Optional, separate service-role connection for the critical-operation worker.
# Remains disabled until physical and hosted archive deployments are independently verified.
CRITICAL_OPERATION_ENGINE_ENABLED=false
CRITICAL_OPERATION_DATABASE_URL=postgresql://replace_with_critical_operation_service_username:replace_with_critical_operation_service_password@localhost:5434/platform_dev?schema=public
REDIS_URL=redis://localhost:6380

# Keycloak database and initial administrator credentials.
# Replace these example values with private local development passwords.
KEYCLOAK_DB_PASSWORD=replace_with_a_private_database_password
KEYCLOAK_ADMIN_USERNAME=replace_with_keycloak_admin_username
KEYCLOAK_ADMIN_PASSWORD=replace_with_a_private_admin_password

# Platform OIDC configuration.
OIDC_ISSUER_URL=http://localhost:8080/realms/distributed-business-platform
OIDC_AUDIENCE=distributed-business-platform-api
OIDC_CLIENT_ID=distributed-business-platform-web
OIDC_CLIENT_SECRET=replace_with_a_private_client_secret
OIDC_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback
# Restricted identity-link callback capability; grant only its narrowly scoped database role.
IDENTITY_LINK_CALLBACK_DATABASE_URL=postgresql://replace_with_identity_link_callback_username:replace_with_identity_link_callback_password@localhost:5434/platform_dev?schema=public
# Set only in an authorized operator's trusted terminal environment; never grant to ordinary administrators.
IDENTITY_LINK_OPERATOR_DATABASE_URL=postgresql://replace_with_identity_link_operator_username:replace_with_identity_link_operator_password@localhost:5434/platform_dev?schema=public
# Initial-owner CLI role and external verifier key. Generate the verifier key out of band (32+ random bytes, base64url).
PLATFORM_OWNER_OPERATOR_DATABASE_URL=postgresql://replace_with_platform_owner_operator_username:replace_with_platform_owner_operator_password@localhost:5434/platform_dev?schema=public
PLATFORM_OWNER_VERIFIER_KEY_ID=replace_with_key_version_id
PLATFORM_OWNER_VERIFIER_KEY=replace_with_32_or_more_random_bytes_base64url
VITE_API_BASE_URL=http://localhost:3001
