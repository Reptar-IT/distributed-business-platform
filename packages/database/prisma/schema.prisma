
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VentureStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  PAUSED
  ARCHIVED
}

model PlatformUser {
  id          String     @id @default(uuid()) @db.Uuid
  displayName String
  status      UserStatus @default(ACTIVE)

  identities  UserIdentity[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("platform_users")
}

model UserIdentity {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid

  issuer        String
  subject       String

  email         String?
  emailVerified Boolean  @default(false)

  user          PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([issuer, subject])
  @@index([userId])

  @@map("user_identities")
}

model Venture {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  description String?
  status      VentureStatus @default(DRAFT)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("ventures")
}
