generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserIdentityStatus {
  ACTIVE
  PENDING_OWNER_RECOVERY
  OWNER_RECOVERY_FAILED
}

enum VentureStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ENDED
}

enum MembershipEndReason {
  ROLE_NOT_AWARDED
  APPLICATION_DECLINED
  WITHDRAWN
  INVITATION_EXPIRED
}

enum OrganizationalRoleStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum AssignmentType {
  PRIMARY
  ACTING
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum VacancyStatus {
  OPEN
  RECRUITING_VENTURE
  RECRUITING_PLATFORM
  RECRUITING_EXTERNAL
  AWAITING_DECISION
  AUTOMATED_PLACEMENT
  OFFER_PENDING
  FILLED
  UNRESOLVED
  CANCELLED
}

enum AuthorizationAuditActorType {
  HUMAN
  MACHINE
  SYSTEM
  BOOTSTRAP
}

enum AuthorizationAuditDecision {
  ALLOW
  DENY
  NOT_APPLICABLE
}

enum AuditExportStatus {
  PENDING
  ACKNOWLEDGED
}

enum AuditDestinationType {
  PHYSICAL
  HOSTED
}

enum CriticalOperationStatus {
  PREPARED
  AWAITING_ARCHIVE
  READY_TO_ACTIVATE
  REVOCATION_PENDING_ARCHIVE
  COMPLETED
  FAILED
  RECONCILIATION_REQUIRED
}

enum IdentityLinkChallengeStatus {
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

enum PlatformOwnerDesignationStatus {
  PENDING
  ACTIVE
  FAILED
}

enum PlatformInitializationState {
  UNINITIALIZED
  INITIALIZED
}

enum OwnerBootstrapCredentialStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED
}

enum OwnerRecoveryKitStatus {
  ACTIVE
  REPLACED
}

enum OwnerRecoveryCodeStatus {
  UNUSED
  CONSUMED
  REVOKED
}

enum OwnerRecoveryStatus {
  INITIATED
  CHALLENGE_PREPARED
  OIDC_PROOF_VERIFIED
  PREPARED
  AWAITING_ARCHIVE
  READY_TO_FINALIZE
  RECONCILIATION_REQUIRED
  FINALIZED
  FAILED
  EXPIRED
}

model PlatformUser {
  id          String     @id @default(uuid()) @db.Uuid
  displayName String
  status      UserStatus @default(ACTIVE)

  identities  UserIdentity[]
  memberships VentureMembership[]
  identityLinkChallenges IdentityLinkChallenge[]
  identityVerifications UserIdentityVerification[]
  ownerDesignations PlatformOwnerDesignation[]
  ownerBootstrapCredentials OwnerBootstrapCredential[]
  ownerRecoveryKits OwnerRecoveryKit[]
  ownerRecoveryOperations OwnerRecoveryOperation[]
  ownerRecoveryVerifications OwnerRecoveryVerification[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("platform_users")
}

model UserIdentity {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  issuer        String
  subject       String
  email         String?
  emailVerified Boolean  @default(false)
  status        UserIdentityStatus @default(ACTIVE)
  ownerRecoveryOperationId String? @unique @db.Uuid

  user          PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  verification  UserIdentityVerification?
  bootstrapCredentials OwnerBootstrapCredential[]
  ownerDesignations PlatformOwnerDesignation[]
  ownerRecoveryOperation OwnerRecoveryOperation? @relation(fields: [ownerRecoveryOperationId], references: [id], onDelete: Restrict)
  ownerRecoveryVerification OwnerRecoveryVerification?
  ownerRecoveryKits OwnerRecoveryKit[] @relation("OwnerRecoveryKitAuthIdentity")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([issuer, subject])
  @@unique([id, userId], map: "user_identities_id_user_key")
  @@unique([id, userId, issuer, subject], map: "user_identities_provenance_binding_key")
  @@index([userId])
  @@map("user_identities")
}

model IdentityLinkChallenge {
  id                  String                      @id @db.Uuid
  platformUserId      String                      @db.Uuid
  expectedIssuer      String
  initiatedBy         String                      @db.VarChar(200)
  status              IdentityLinkChallengeStatus @default(PENDING)
  expiresAt           DateTime                    @db.Timestamptz(6)
  completedAt         DateTime?                   @db.Timestamptz(6)
  outcomeCode         String?                     @db.VarChar(100)
  user                PlatformUser                @relation(fields: [platformUserId], references: [id], onDelete: Restrict)
  verification        UserIdentityVerification?
  createdAt           DateTime                    @default(now()) @db.Timestamptz(6)

  @@index([status, expiresAt])
  @@map("identity_link_challenges")
}

model UserIdentityVerification {
  id                String              @id @db.Uuid
  userIdentityId    String              @unique @db.Uuid
  platformUserId    String              @db.Uuid
  issuer            String
  subject           String
  challengeId       String              @unique @db.Uuid
  initiatingOperator String             @db.VarChar(200)
  proofMethod       String              @db.VarChar(100)
  verifiedAt        DateTime            @db.Timestamptz(6)
  identity          UserIdentity        @relation(fields: [userIdentityId], references: [id], onDelete: Restrict)
  user              PlatformUser        @relation(fields: [platformUserId], references: [id], onDelete: Restrict)
  challenge         IdentityLinkChallenge @relation(fields: [challengeId], references: [id], onDelete: Restrict)

  @@map("user_identity_verifications")
}

model PlatformInitialization {
  id                   Int                         @id @default(1)
  state                PlatformInitializationState @default(UNINITIALIZED)
  activeDesignationId  String?                     @unique @db.Uuid
  initializedAt        DateTime?                   @db.Timestamptz(6)
  activeDesignation    PlatformOwnerDesignation?   @relation(fields: [activeDesignationId], references: [id], onDelete: Restrict)

  @@map("platform_initialization")
}

model OwnerBootstrapCredential {
  id                 String                        @id @db.Uuid
  platformUserId     String                        @db.Uuid
  userIdentityId     String                        @db.Uuid
  verifierKeyId      String                        @db.VarChar(100)
  verifier           Bytes
  status             OwnerBootstrapCredentialStatus @default(ACTIVE)
  issuedBy           String                        @db.VarChar(200)
  expiresAt          DateTime                      @db.Timestamptz(6)
  consumedAt         DateTime?                     @db.Timestamptz(6)
  operationId        String?                       @unique @db.Uuid
  user               PlatformUser                  @relation(fields: [platformUserId], references: [id], onDelete: Restrict)
  identity           UserIdentity                  @relation(fields: [userIdentityId, platformUserId], references: [id, userId], onDelete: Restrict)
  criticalOperation  CriticalOperation?             @relation("OwnerBootstrapCredentialOperation", fields: [operationId], references: [id], onDelete: Restrict)
  createdAt          DateTime                      @default(now()) @db.Timestamptz(6)

  @@index([platformUserId, status])
  @@map("owner_bootstrap_credentials")
}

model OwnerRecoveryKit {
  id                      String @id @db.Uuid
  designationId           String @db.Uuid
  platformUserId          String @db.Uuid
  authenticatedIdentityId String @db.Uuid
  authenticatedIssuer     String
  authenticatedSubject    String
  generation              Int
  status                  OwnerRecoveryKitStatus @default(ACTIVE)
  issuedAt                DateTime @default(now()) @db.Timestamptz(6)
  replacedAt              DateTime? @db.Timestamptz(6)
  designation             PlatformOwnerDesignation @relation(fields: [designationId], references: [id], onDelete: Restrict)
  user                    PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Restrict)
  authenticatedIdentity   UserIdentity @relation("OwnerRecoveryKitAuthIdentity", fields: [authenticatedIdentityId, platformUserId, authenticatedIssuer, authenticatedSubject], references: [id, userId, issuer, subject], onDelete: Restrict)
  codes                   OwnerRecoveryCode[]

  @@unique([designationId, generation])
  @@index([platformUserId, issuedAt])
  @@map("owner_recovery_kits")
}

model OwnerRecoveryCode {
  id                       String @id @db.Uuid
  kitId                    String @db.Uuid
  verifierKeyId            String @db.VarChar(100)
  verifier                 Bytes
  status                   OwnerRecoveryCodeStatus @default(UNUSED)
  consumedAt               DateTime? @db.Timestamptz(6)
  usedByRecoveryOperationId String? @unique @db.Uuid
  createdAt                DateTime @default(now()) @db.Timestamptz(6)
  kit                      OwnerRecoveryKit @relation(fields: [kitId], references: [id], onDelete: Restrict)
  usedByRecovery           OwnerRecoveryOperation? @relation("OwnerRecoveryCodeUse", fields: [usedByRecoveryOperationId], references: [id], onDelete: Restrict)
  recovery                OwnerRecoveryOperation? @relation("OwnerRecoveryCode")

  @@unique([verifierKeyId, verifier])
  @@index([kitId, status])
  @@map("owner_recovery_codes")
}

model OwnerRecoveryOperation {
  id                  String @id @db.Uuid
  designationId       String @db.Uuid
  platformUserId      String @db.Uuid
  recoveryCodeId      String @unique @db.Uuid
  expectedIssuer      String
  status              OwnerRecoveryStatus @default(INITIATED)
  expiresAt           DateTime @db.Timestamptz(6)
  initiatedAt         DateTime @default(now()) @db.Timestamptz(6)
  challengePreparedAt DateTime? @db.Timestamptz(6)
  proofVerifiedAt     DateTime? @db.Timestamptz(6)
  preparedAt          DateTime? @db.Timestamptz(6)
  archiveQualifiedAt  DateTime? @db.Timestamptz(6)
  finalizedAt         DateTime? @db.Timestamptz(6)
  failedAt            DateTime? @db.Timestamptz(6)
  outcomeCode         String? @db.VarChar(100)
  criticalOperationId String? @unique @db.Uuid
  designation         PlatformOwnerDesignation @relation(fields: [designationId], references: [id], onDelete: Restrict)
  user                PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Restrict)
  recoveryCode        OwnerRecoveryCode @relation("OwnerRecoveryCode", fields: [recoveryCodeId], references: [id], onDelete: Restrict)
  consumedCode        OwnerRecoveryCode? @relation("OwnerRecoveryCodeUse")
  criticalOperation   CriticalOperation? @relation("OwnerRecoveryCriticalOperation", fields: [criticalOperationId], references: [id], onDelete: Restrict)
  pendingIdentity     UserIdentity?
  verification        OwnerRecoveryVerification?

  @@index([status, expiresAt])
  @@index([designationId, initiatedAt])
  @@map("owner_recovery_operations")
}

model OwnerRecoveryVerification {
  id                  String @id @db.Uuid
  recoveryOperationId String @unique @db.Uuid
  userIdentityId      String @unique @db.Uuid
  platformUserId      String @db.Uuid
  issuer              String
  subject             String
  proofMethod         String @db.VarChar(100)
  verifiedAt          DateTime @db.Timestamptz(6)
  activatedAt         DateTime? @db.Timestamptz(6)
  operation           OwnerRecoveryOperation @relation(fields: [recoveryOperationId], references: [id], onDelete: Restrict)
  identity            UserIdentity @relation(fields: [userIdentityId], references: [id], onDelete: Restrict)
  user                PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Restrict)

  @@map("owner_recovery_verifications")
}

model PlatformOwnerDesignation {
  id                    String                          @id @db.Uuid
  platformUserId        String                          @db.Uuid
  userIdentityId        String                          @db.Uuid
  criticalOperationId   String                          @unique @db.Uuid
  status                PlatformOwnerDesignationStatus @default(PENDING)
  preparedAt            DateTime                        @db.Timestamptz(6)
  activatedAt           DateTime?                       @db.Timestamptz(6)
  user                  PlatformUser                    @relation(fields: [platformUserId], references: [id], onDelete: Restrict)
  identity              UserIdentity                    @relation(fields: [userIdentityId, platformUserId], references: [id, userId], onDelete: Restrict)
  criticalOperation     CriticalOperation               @relation("OwnerBootstrapOperation", fields: [criticalOperationId], references: [id], onDelete: Restrict)
  initializationRecord PlatformInitialization?
  recoveryKits OwnerRecoveryKit[]
  recoveryOperations OwnerRecoveryOperation[]

  @@index([platformUserId, status])
  @@map("platform_owner_designations")
}

model Venture {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  description String?
  status      VentureStatus @default(DRAFT)

  memberships VentureMembership[]
  roles       OrganizationalRole[]
  vacancies   RoleVacancy[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("ventures")
}

model VentureMembership {
  id        String           @id @default(uuid()) @db.Uuid
  ventureId String           @db.Uuid
  userId    String           @db.Uuid
  status    MembershipStatus @default(PENDING)

  joinedAt  DateTime?
  endedAt   DateTime?
  endReason MembershipEndReason?

  venture   Venture      @relation(fields: [ventureId], references: [id], onDelete: Restrict)
  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  assignments RoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, ventureId])
  @@index([userId])
  @@index([ventureId, status])
  @@map("venture_memberships")
}

model OrganizationalRole {
  id           String                   @id @default(uuid()) @db.Uuid
  ventureId    String                   @db.Uuid
  parentRoleId String?                  @db.Uuid

  title             String
  description       String?
  responsibilities Json?
  authorityScope    Json?
  requirements      Json?

  status      OrganizationalRoleStatus @default(DRAFT)
  isMandatory Boolean                  @default(false)

  venture     Venture                  @relation(fields: [ventureId], references: [id], onDelete: Restrict)
  parentRole  OrganizationalRole?      @relation("RoleHierarchy", fields: [parentRoleId, ventureId], references: [id, ventureId], onDelete: Restrict)
  childRoles  OrganizationalRole[]     @relation("RoleHierarchy")

  assignments RoleAssignment[]
  vacancies   RoleVacancy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, ventureId])
  @@index([ventureId, status])
  @@index([parentRoleId])
  @@map("organizational_roles")
}

model RoleAssignment {
  id                   String           @id @default(uuid()) @db.Uuid
  membershipId         String           @db.Uuid
  organizationalRoleId String           @db.Uuid
  ventureId            String           @db.Uuid

  assignmentType AssignmentType
  status         AssignmentStatus @default(ACTIVE)

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  membership         VentureMembership @relation(fields: [membershipId, ventureId], references: [id, ventureId], onDelete: Restrict)
  organizationalRole OrganizationalRole @relation(fields: [organizationalRoleId, ventureId], references: [id, ventureId], onDelete: Restrict)

  createdVacancy RoleVacancy? @relation("VacancyPreviousAssignment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, ventureId])
  @@index([membershipId, status])
  @@index([organizationalRoleId, status])
  @@index([assignmentType, status])
  @@map("role_assignments")
}

model RoleVacancy {
  id                   String        @id @default(uuid()) @db.Uuid
  ventureId            String        @db.Uuid
  organizationalRoleId String       @db.Uuid

  previousAssignmentId String?       @db.Uuid
  sourceVacancyId      String?       @db.Uuid

  status VacancyStatus @default(OPEN)

  openedAt           DateTime  @default(now())
  resolutionDeadline DateTime?
  resolvedAt         DateTime?

  venture              Venture             @relation(fields: [ventureId], references: [id], onDelete: Restrict)
  organizationalRole   OrganizationalRole  @relation(fields: [organizationalRoleId, ventureId], references: [id, ventureId], onDelete: Restrict)
  previousAssignment   RoleAssignment?      @relation("VacancyPreviousAssignment", fields: [previousAssignmentId, ventureId], references: [id, ventureId], onDelete: Restrict)
  sourceVacancy        RoleVacancy?         @relation("VacancyCascade", fields: [sourceVacancyId, ventureId], references: [id, ventureId], onDelete: Restrict)
  resultingVacancies   RoleVacancy[]        @relation("VacancyCascade")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, ventureId])
  @@unique([previousAssignmentId, ventureId])
  @@index([ventureId, status])
  @@index([organizationalRoleId, status])
  @@index([sourceVacancyId])
  @@map("role_vacancies")
}

model AuthorizationAuditStream {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  head         AuthorizationAuditHead?
  events       AuthorizationAuditEvent[]
  checkpoints  AuditExportCheckpoint[]
  batches      AuditExportBatch[]

  @@map("authorization_audit_streams")
}

model AuthorizationAuditHead {
  streamId       String   @id @db.Uuid
  lastSequence   BigInt   @default(0)
  lastEventHash  Bytes
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  stream AuthorizationAuditStream @relation(fields: [streamId], references: [id], onDelete: Restrict)

  @@map("authorization_audit_heads")
}

model AuthorizationAuditEvent {
  id                       String                       @id @default(uuid()) @db.Uuid
  streamId                 String                       @db.Uuid
  sequence                 BigInt
  eventType                String                       @db.VarChar(100)
  actorType                AuthorizationAuditActorType
  actorId                  String                       @db.VarChar(200)
  delegatingHumanId        String?                      @db.VarChar(200)
  callingClientId          String?                      @db.VarChar(200)
  permissionCode           String?                      @db.VarChar(200)
  decision                 AuthorizationAuditDecision  @default(NOT_APPLICABLE)
  decisionReasonCode       String?                      @db.VarChar(100)
  targetType               String?                      @db.VarChar(100)
  targetId                 String?                      @db.VarChar(200)
  ventureId                String?                      @db.Uuid
  delegationId             String?                      @db.Uuid
  approvalId               String?                      @db.Uuid
  policyVersion            String?                      @db.VarChar(100)
  operation                String                       @db.VarChar(100)
  outcome                  String                       @db.VarChar(100)
  requestId                String?                      @db.VarChar(200)
  jobId                    String?                      @db.VarChar(200)
  correlationId            String?                      @db.VarChar(200)
  occurredAt               DateTime                     @db.Timestamptz(6)
  serializationVersion     Int                          @default(1)
  hashVersion              Int                          @default(1)
  canonicalPayload         String                       @db.Text
  previousHash             Bytes
  eventHash                Bytes

  stream AuthorizationAuditStream @relation(fields: [streamId], references: [id], onDelete: Restrict)
  criticalIntentOperations CriticalOperation[] @relation("CriticalIntentEvent")
  criticalBoundaryOperations CriticalOperation[] @relation("CriticalBoundaryEvent")
  criticalCompletionOperations CriticalOperation[] @relation("CriticalCompletionEvent")

  @@unique([streamId, sequence])
  @@index([actorType, actorId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([correlationId])
  @@index([ventureId, occurredAt])
  @@map("authorization_audit_events")
}

model AuditDestination {
  id                  String                @id @db.VarChar(80)
  type                AuditDestinationType
  enabled             Boolean               @default(true)
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  lastSucceededAt     DateTime?             @db.Timestamptz(6)
  consecutiveFailures Int                   @default(0)
  lastErrorCategory   String?               @db.VarChar(100)
  updatedAt           DateTime              @default(now()) @updatedAt @db.Timestamptz(6)

  checkpoints AuditExportCheckpoint[]
  deliveries  AuditExportDelivery[]

  @@map("audit_destinations")
}

model AuditExportCheckpoint {
  streamId                    String   @db.Uuid
  destinationId               String   @db.VarChar(80)
  lastAcknowledgedSequence    BigInt   @default(0)
  lastAcknowledgedEventHash   Bytes
  updatedAt                   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  stream      AuthorizationAuditStream @relation(fields: [streamId], references: [id], onDelete: Restrict)
  destination AuditDestination         @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@id([streamId, destinationId])
  @@map("audit_export_checkpoints")
}

model AuditExportBatch {
  id                 String           @id @default(uuid()) @db.Uuid
  streamId           String           @db.Uuid
  firstSequence      BigInt
  lastSequence       BigInt
  eventCount         Int
  previousHash       Bytes
  terminalEventHash  Bytes
  batchHash          Bytes
  canonicalBatch     String           @db.Text
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)

  stream      AuthorizationAuditStream @relation(fields: [streamId], references: [id], onDelete: Restrict)
  deliveries  AuditExportDelivery[]

  @@unique([streamId, firstSequence])
  @@map("audit_export_batches")
}

model AuditExportDelivery {
  batchId       String            @db.Uuid
  destinationId String            @db.VarChar(80)
  status        AuditExportStatus @default(PENDING)
  attempts      Int               @default(0)
  nextAttemptAt DateTime          @default(now()) @db.Timestamptz(6)
  lastErrorCode String?           @db.VarChar(100)
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  batch       AuditExportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  destination AuditDestination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  receipt     AuditArchiveReceipt?

  @@id([batchId, destinationId])
  @@index([destinationId, status, nextAttemptAt])
  @@map("audit_export_deliveries")
}

model AuditArchiveReceipt {
  id                String   @id @default(uuid()) @db.Uuid
  batchId           String   @db.Uuid
  destinationId     String   @db.VarChar(80)
  batchHash         Bytes
  firstSequence     BigInt
  lastSequence      BigInt
  terminalEventHash Bytes
  acceptedAt        DateTime @db.Timestamptz(6)
  keyId             String   @db.VarChar(100)
  receiptPayload    String   @db.Text
  signature         Bytes
  verifiedAt        DateTime @default(now()) @db.Timestamptz(6)

  delivery    AuditExportDelivery @relation(fields: [batchId, destinationId], references: [batchId, destinationId], onDelete: Restrict)
  criticalOperations CriticalOperation[]

  @@unique([batchId, destinationId])
  @@index([destinationId, acceptedAt])
  @@map("audit_archive_receipts")
}

model CriticalOperation {
  id                         String                  @id @default(uuid()) @db.Uuid
  operationType              String                  @db.VarChar(100)
  targetType                 String                  @db.VarChar(100)
  targetId                   String                  @db.VarChar(200)
  idempotencyDigest          Bytes                   @unique
  requestFingerprint         Bytes
  status                     CriticalOperationStatus @default(PREPARED)
  streamId                   String                  @db.Uuid
  intentEventId              String                  @db.Uuid
  intentSequence             BigInt
  readyOrRevocationEventId   String?                 @db.Uuid
  readyOrRevocationSequence  BigInt?
  completionEventId          String?                 @db.Uuid
  completionSequence         BigInt?
  qualifyingReceiptId        String?                 @db.Uuid
  qualifyingDestinationId    String?                 @db.VarChar(80)
  qualifyingKeyId            String?                 @db.VarChar(100)
  failureCategory            String?                 @db.VarChar(100)
  reconciliationMetadata     Json?
  intentEvent                AuthorizationAuditEvent @relation("CriticalIntentEvent", fields: [intentEventId], references: [id], onDelete: Restrict)
  readyOrRevocationEvent     AuthorizationAuditEvent? @relation("CriticalBoundaryEvent", fields: [readyOrRevocationEventId], references: [id], onDelete: Restrict)
  completionEvent            AuthorizationAuditEvent? @relation("CriticalCompletionEvent", fields: [completionEventId], references: [id], onDelete: Restrict)
  qualifyingReceipt          AuditArchiveReceipt?    @relation(fields: [qualifyingReceiptId], references: [id], onDelete: Restrict)
  gate                       CriticalOperationGate?
  ownerDesignation           PlatformOwnerDesignation? @relation("OwnerBootstrapOperation")
  bootstrapCredential        OwnerBootstrapCredential? @relation("OwnerBootstrapCredentialOperation")
  ownerRecoveryOperation     OwnerRecoveryOperation? @relation("OwnerRecoveryCriticalOperation")
  createdAt                  DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  completedAt                DateTime?               @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("critical_operations")
}

model CriticalOperationGate {
  targetType  String   @db.VarChar(100)
  targetId    String   @db.VarChar(200)
  state       String   @db.VarChar(20)
  operationId String   @db.Uuid
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  operation   CriticalOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@id([targetType, targetId])
  @@index([operationId])
  @@unique([operationId])
  @@map("critical_operation_gates")
}
